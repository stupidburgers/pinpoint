--- a/styles.css
+++ b/styles.css
@@ -105,7 +105,7 @@
 .pricing { background: var(--card); border-block: 1px solid var(--rule); padding-block: clamp(56px, 8vw, 112px); }
 .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2.5vw, 32px); align-items: stretch; }
 .plan { display: flex; flex-direction: column; gap: 10px; padding: 32px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--card); }
-.plan h4 { font-size: 1.75rem; }
+.plan h3 { font-size: 1.75rem; }
 .price { color: var(--ink-soft); }
 .amount { font: 500 3rem/1 var(--serif); color: var(--ink); margin-right: 4px; }
 .plan-desc { color: var(--ink-soft); margin-bottom: 8px; }
